# --- Database (SQLite file, relative to the repo root) ---
DATABASE_URL="file:./dev.db"

# --- Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET=
# Lets Auth.js run on both http://localhost:3000 and your public tunnel host.
AUTH_TRUST_HOST=true

# --- Google OAuth (Web application client; enable the Google Calendar API) ---
# Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
#                           https://<your-public-host>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Public URL of this app's MCP server (must be reachable from Anthropic's servers) ---
# Use a reserved/stable tunnel hostname; the URL is baked into the agent and every vault credential.
MCP_PUBLIC_URL=https://<your-public-host>/api/mcp

# Optional, and strongly recommended: a named cloudflared tunnel whose hostname survives restarts.
# `make up` runs this tunnel and writes MCP_PUBLIC_URL itself. Leave both empty and it falls back to
# a throwaway quick tunnel, which means re-registering the Console webhook every time.
TUNNEL_NAME=
TUNNEL_HOSTNAME=

# --- Anthropic Managed Agents ---
# Optional if you are logged in with `ant auth login`.
ANTHROPIC_API_KEY=
# Workspace id used only to build session trace URLs (default: "default").
ANTHROPIC_WORKSPACE_ID=
# Filled in by: npm run setup:anthropic -- --write
ANTHROPIC_ENVIRONMENT_ID=
VACATION_AGENT_ID=
# From the webhook you register in the Claude Console (session.status_idled, session.status_terminated).
ANTHROPIC_WEBHOOK_SIGNING_KEY=

# --- App ---
# Comma-separated emails that get the MANAGER role when they sign in (or via `npm run db:seed`).
MANAGER_EMAILS=you@example.com
