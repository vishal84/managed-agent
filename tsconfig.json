{
  // Node-side tooling only (scripts/, prisma/). The Next.js app has its own config at frontend/tsconfig.json.
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": ["./frontend/src/*"]
    }
  },
  "include": ["prisma.config.ts", "scripts/**/*.ts", "prisma/**/*.ts"],
  "exclude": ["node_modules", "frontend"]
}
