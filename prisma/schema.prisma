generator client {
  provider = "prisma-client"
  output   = "../frontend/src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  EMPLOYEE
  MANAGER
}

enum LeaveReason {
  PTO
  SICK
  BEREAVEMENT
  OTHER
}

enum RequestStatus {
  PENDING
  APPROVED
  DENIED
}

enum CalendarJobStatus {
  NOT_STARTED
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(EMPLOYEE)

  anthropicVaultId   String?
  vaultCredentialId  String?
  vaultCredentialUrl String?

  accounts  Account[]
  sessions  Session[]
  requests  VacationRequest[] @relation("Requester")
  decisions VacationRequest[] @relation("Decider")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model VacationRequest {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation("Requester", fields: [userId], references: [id], onDelete: Cascade)
  startDate DateTime
  endDate   DateTime
  timeZone  String
  reason    LeaveReason
  comments  String?
  status    RequestStatus @default(PENDING)
  createdAt DateTime      @default(now())

  decidedById  String?
  decidedBy    User?     @relation("Decider", fields: [decidedById], references: [id])
  decidedAt    DateTime?
  decisionNote String?

  calendarJobStatus     CalendarJobStatus @default(NOT_STARTED)
  calendarJobAttempts   Int               @default(0)
  agentSessionId        String?
  calendarEventId       String?
  calendarEventHtmlLink String?
  calendarJobError      String?
  calendarJobStartedAt  DateTime?
  calendarJobFinishedAt DateTime?

  @@index([status])
  @@index([userId])
  @@index([calendarJobStatus])
}

model ProcessedWebhook {
  id         String   @id
  receivedAt DateTime @default(now())
}
